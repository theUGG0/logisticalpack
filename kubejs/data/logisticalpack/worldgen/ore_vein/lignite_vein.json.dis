{
  "_comment": "Lignite vein — shallow, wide, common. Real lignite forms in sedimentary basins near the surface, so we keep it above Y=40 and bias the block table heavily toward the stone-hosted variant.",

  "ore": {
    "type": "minecraft:weighted_state_provider",
    "entries": [
      { "weight": 4, "data": { "Name": "logisticalpack:lignite_ore" } },
      { "weight": 1, "data": { "Name": "logisticalpack:deepslate_lignite_ore" } }
    ]
  },

  "_comment_secondary": "Secondary block placed instead of the main ore at secondary_ore_chance. We use the deepslate variant here too so the ore concentration looks natural rather than seeing raw blocks of an item we don't have.",
  "secondary_ore": "logisticalpack:lignite_ore",
  "secondary_ore_chance": 0.05,

  "filler_block": {
    "type": "minecraft:weighted_state_provider",
    "entries": [
      { "weight": 3, "data": { "Name": "minecraft:stone" } },
      { "weight": 1, "data": { "Name": "minecraft:dirt" } }
    ]
  },

  "dimension": [
    "minecraft:overworld"
  ],

  "_comment_toggle": "Standard ore_veininess noise — same approach used by the example gold/diamond veins shipped with DOV.",
  "vein_toggle": {
    "input": {
      "type": "minecraft:interpolated",
      "argument": {
        "type": "minecraft:noise",
        "noise": "minecraft:ore_veininess",
        "xz_scale": 1.5,
        "y_scale": 1.5
      }
    }
  },

  "vein_ridged": {
    "input": {
      "type": "minecraft:add",
      "argument1": -0.07999999821186066,
      "argument2": {
        "type": "minecraft:max",
        "argument1": {
          "type": "minecraft:abs",
          "argument": {
            "type": "minecraft:interpolated",
            "argument": {
              "type": "minecraft:noise",
              "noise": "minecraft:ore_vein_a",
              "xz_scale": 4,
              "y_scale": 4
            }
          }
        },
        "argument2": {
          "type": "minecraft:abs",
          "argument": {
            "type": "minecraft:interpolated",
            "argument": {
              "type": "minecraft:noise",
              "noise": "minecraft:ore_vein_b",
              "xz_scale": 4,
              "y_scale": 4
            }
          }
        }
      }
    }
  },

  "vein_gap": {},

  "_comment_settings": "Higher richness than vanilla because lignite was historically the most abundant coal. Generous min/max ore richness keeps veins meaty.",
  "vein_settings": {
    "min_ore_richness": 0.25,
    "max_ore_richness": 0.55,
    "min_richness_threshold": 0.3,
    "max_richness_threshold": 0.55,
    "vein_solidness": 0.7,
    "edge_roundoff_begin": 12,
    "max_edge_roundoff": 0.2
  },

  "_comment_conditions": "Shallow vein: above sea level, below the typical surface foliage layer. 40 to 80 absolute Y matches real lignite seams which sit above the deeper bituminous layers.",
  "conditions": [
    {
      "type": "dynamic_veins:height_range",
      "min_inclusive": { "absolute": 40 },
      "max_inclusive": { "absolute": 80 }
    }
  ]
}
