# Per-user configuration for packwiz-manager.py and the helper scripts.
# Copy this file to .env (which is gitignored) and fill in your own values.
# All keys are also editable via the in-app Settings tab.

# --- Prism Launcher --------------------------------------------------------

# Path to the Prism instance's .minecraft folder. Examples:
#   Linux (system Prism):  ~/.local/share/PrismLauncher/instances/MyPack/.minecraft
#   Linux (Flatpak):       ~/.var/app/org.prismlauncher.PrismLauncher/data/PrismLauncher/instances/MyPack/.minecraft
#   macOS:                 ~/Library/Application Support/PrismLauncher/instances/MyPack/.minecraft
#   Windows:               %APPDATA%\PrismLauncher\instances\MyPack\.minecraft
INSTANCE=

# --- Pack distribution -----------------------------------------------------

# Production pack.toml URL — usually GitHub Pages.
# Used by the legacy apply-to-prism.py and by Local→Server.
PACK_URL=

# Optional dev pack URL (used by `apply-to-prism.py --dev`).
# packwiz-manager.py spins up its own packwiz serve on a free port, so
# this can stay empty.
DEV_PACK_URL=

# --- CurseForge API --------------------------------------------------------

# Free key from https://console.curseforge.com — required for CF lookups
# and to convert metadata:curseforge entries to direct download URLs.
CURSEFORGE_API_KEY=

# --- Server (Crafty Controller) — Linux/macOS only -------------------------
# Leave these blank if you don't have a server (the Deploy card stays disabled).

CRAFTY_URL=
CRAFTY_TOKEN=
CRAFTY_SERVER_ID=
CRAFTY_INSECURE=true

# Used by the rsync deploy step. CRAFTY_SSH_HOST is an alias from ~/.ssh/config.
CRAFTY_SSH_HOST=
CRAFTY_REMOTE_ROOT=

# --- Binary overrides (rare) -----------------------------------------------
# Only set these if packwiz / java aren't on PATH and aren't auto-detected.
# Use absolute paths. Examples:
#   Linux:    PACKWIZ_BIN=/home/you/.local/bin/packwiz
#   Windows:  PACKWIZ_BIN=C:\Users\you\go\bin\packwiz.exe

PACKWIZ_BIN=
JAVA_BIN=
